# ─────────────────────────────────────────────────────────────────────────────
# GSIP — GatiShakti Intelligence Platform
# Environment Variables
# Copy this file to .env and fill in values before running `make dev`
# ─────────────────────────────────────────────────────────────────────────────

# ─── Database ─────────────────────────────────────────────────────────────────
# Async connection string for FastAPI/SQLAlchemy
DATABASE_URL=postgresql+asyncpg://gsip:gsip_dev@localhost:5432/gsip
# Sync connection string for Alembic migrations
DATABASE_SYNC_URL=postgresql+psycopg2://gsip:gsip_dev@localhost:5432/gsip
# Raw credentials (used by docker-compose directly)
POSTGRES_PASSWORD=gsip_dev

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ─── MinIO (S3-compatible object storage) ─────────────────────────────────────
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=gsip
MINIO_SECRET_KEY=gsip_dev_secret
# Change in production — min 8 characters
MINIO_BUCKET=gsip-layers

# ─── GeoServer ────────────────────────────────────────────────────────────────
GEOSERVER_URL=http://localhost:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=gsip_geo
GEOSERVER_WORKSPACE=gsip

# ─── Tile Server ──────────────────────────────────────────────────────────────
# TileServer GL serves MBTiles vector tiles
TILESERVER_URL=http://localhost:8081
# OpenFreeMap base style — free, no API key required
NEXT_PUBLIC_BASE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty

# ─── OSRM Routing ─────────────────────────────────────────────────────────────
OSRM_URL=http://localhost:5000

# ─── AI Layer (Anthropic Claude) ──────────────────────────────────────────────
# Required only if ENABLE_AI_QUERY=true
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_key_here
ANTHROPIC_MODEL=claude-sonnet-4-20250514
# Max tokens to request from Claude for NL→SQL
ANTHROPIC_MAX_TOKENS=1024

# ─── Auth (Supabase — free tier) ──────────────────────────────────────────────
# Leave blank to run in dev mode with no authentication
# Get from: https://app.supabase.com/project/<id>/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Get from: Settings → API → JWT Settings → JWT Secret  (used to verify tokens locally)
SUPABASE_JWT_SECRET=

# ─── Production SSL (Let's Encrypt) ───────────────────────────────────────────
# Required for docker-compose.prod.yml + nginx-ssl.conf
# GSIP_DOMAIN=gsip.yourdomain.in
# CERT_EMAIL=admin@yourdomain.in

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_TILE_URL=http://localhost:8081
# Supabase — required when ENABLE_AUTH=true (same values as backend)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─── Airflow ──────────────────────────────────────────────────────────────────
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://gsip:gsip_dev@localhost:5432/gsip_airflow
AIRFLOW_ADMIN_PASSWORD=gsip_airflow

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=gsip_grafana
# Prometheus scrape interval (seconds)
PROMETHEUS_SCRAPE_INTERVAL=15

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set true to enable natural language query via Claude API
ENABLE_AI_QUERY=true
# Set true to require authentication on all endpoints (production only)
ENABLE_AUTH=false
# Set true to enable rate limiting on AI query endpoint
ENABLE_RATE_LIMIT=true
# Max NL queries per minute per IP
AI_QUERY_RATE_LIMIT=10

# ─── Application ──────────────────────────────────────────────────────────────
APP_ENV=development  # development | production
LOG_LEVEL=INFO
# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
# Statement timeout for Claude-generated SQL (seconds)
AI_SQL_TIMEOUT_S=10
